# Hostname passkeys are bound to (must match the URL you open the app at).
RP_ID=localhost

# Full origin the app is served from.
ORIGIN=http://localhost:8080

# Host port for the web UI.
WEB_PORT=8080

# Name shown in the passkey prompt.
RP_NAME=openGym

# Optional admin dashboard — comma-separated user ids from ./data/db.json.
# Empty = no admin (default).
ADMIN_UIDS=

# Require an invite code to create a profile. Empty / unset = open signup.
INVITE_ONLY=

# Optional bot token API (Grok / any HTTP client). Empty = feature off; every
# /api/bot/* route returns 404. When set, Authorization: Bearer <token> can
# read and append that one profile's data — treat it like a password.
BOT_TOKEN=

# Existing user id the bot acts as. After you create a profile on YOUR
# instance, copy users[].id from that instance's ./data/db.json.
# Required once BOT_TOKEN is set; unknown / missing → 400/403.
# Do not copy ids out of a data/ folder that shipped in a git clone.
BOT_UID=
